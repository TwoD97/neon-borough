def cmd_answer(args):
    if len(args) < 2: die("usage: herdr-pr answer <id> merged|declined|failed [--message text]")
    ident, state = args[0], args[1]
    if state not in ("merged", "declined", "failed"): die("state must be merged, declined or failed")
    message = args[args.index("--message") + 1] if "--message" in args and args.index("--message") + 1 < len(args) else ""
    a = read_ask(ident)
    if not a: die(f"no ask {ident}")
    a["state"], a["message"], a["updated"] = state, message, time.time()
    write_ask(a)
    print(f"{ident}: {state}")


# --- Secrets: an agent asks the person to put a value into a file; the agent never sees it ---

SECRETS = os.path.join(HOME, "secret-asks")
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_.-]*$")


def secret_path(ident):
    return os.path.join(SECRETS, re.sub(r"[^\w-]", "", ident) + ".json")


def write_secret_ask(item):
    os.makedirs(SECRETS, exist_ok=True)
    tmp = secret_path(item["id"]) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(item, f)
    os.replace(tmp, secret_path(item["id"]))


def read_secret_ask(ident):
    try:
        with open(secret_path(ident)) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def cmd_secret(args):
    if len(args) < 2 or args[0].startswith("-"):
        die("usage: herdr-pr secret <file> <KEY> [--note text] [--wait [--timeout 30m]]")
    path, name = os.path.abspath(os.path.expanduser(args[0])), args[1]
    if not KEY_RE.match(name): die(f"not a variable name: {name}")
    note, wait, timeout = "", False, 30 * 60
    by = os.environ.get("HERDR_PR_BY") or me()
    rest = args[2:]
    while rest:
        a = rest.pop(0)
        if a == "--note" and rest: note = rest.pop(0)
        elif a == "--by" and rest: by = rest.pop(0)
        elif a == "--wait": wait = True
        elif a == "--timeout" and rest: timeout = parse_duration(rest.pop(0))
        else: die(f"unknown option {a}")
    item = {"id": uuid.uuid4().hex[:8], "file": path, "key": name, "note": note, "by": by,
            "exists": os.path.exists(path), "created": time.time(), "updated": time.time(), "state": "pending"}
    write_secret_ask(item)
    print(f"asked for {name} in {path} (id {item['id']}). The person fills it in Herdr's Files panel; you won't see the value.")
    if not wait:
        print(f"check later with: herdr-pr secret-status {item['id']}"); return
    end = time.time() + timeout
    while time.time() < end:
        time.sleep(3)
        cur = read_secret_ask(item["id"])
        if cur and cur["state"] != "pending":
            print(cur["state"]); sys.exit(0 if cur["state"] == "filled" else 1)
    print(f"no answer within {timeout // 60} min; the request stays open (herdr-pr secret-status {item['id']})")
    sys.exit(2)


def cmd_secret_status(args):
    if not args: die("usage: herdr-pr secret-status <id>")
    a = read_secret_ask(args[0])
    if not a: die(f"no secret request {args[0]}")
    print(a["state"])


def cmd_secrets(args):
    try:
        names = sorted(n for n in os.listdir(SECRETS) if n.endswith(".json"))
    except FileNotFoundError:
        names = []
    out, now = [], time.time()
    for n in names:
        a = read_secret_ask(n[:-5])
        if not a: continue
        if a["state"] != "pending" and now - a.get("updated", now) > KEEP_ASKS:
            try: os.remove(os.path.join(SECRETS, n))
            except OSError: pass
            continue
        if a["state"] == "pending" or "--all" in args: out.append(a)
    print(json.dumps(out) if "--json" in args else "\n".join(f"{a['id']} {a['state']} {a['key']} -> {a['file']}" for a in out) or "no requests")


def env_line(name, value, export=""):
    if value == "" or re.search(r"[\s#'\"$\\`]", value):
        value = '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'
    return f"{export}{name}={value}"


def set_env_value(path, name, value):
    """Replaces NAME=... (or export NAME=...) in a dotenv-style file, else appends it. Keeps the file's mode."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
        new = False
    except FileNotFoundError:
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        lines, new = [], True
    pat = re.compile(r"^(\s*)(export\s+)?" + re.escape(name) + r"\s*=")
    done = False
    for i, line in enumerate(lines):
        m = pat.match(line)
        if m:
            lines[i] = m.group(1) + env_line(name, value, m.group(2) or "")
            done = True
            break
    if not done:
        lines.append(env_line(name, value))
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write("\n".join(lines) + "\n")
    if new and not WINDOWS:
        os.chmod(path, 0o600)


def cmd_secret_fill(args):
    """The Files panel: secret-fill <id> <value as base64>. The value is never logged or stored elsewhere."""
    import base64
    if len(args) < 2: die("usage: herdr-pr secret-fill <id> <base64 value>")
    a = read_secret_ask(args[0])
    if not a: die(f"no secret request {args[0]}")
    if a["state"] != "pending": die(f"request {args[0]} is already {a['state']}")
    value = base64.b64decode(args[1]).decode("utf-8")
    set_env_value(a["file"], a["key"], value)
    a["state"], a["updated"] = "filled", time.time()
    write_secret_ask(a)
    log(f"secret {a['key']} filled in {a['file']}")
    print("filled")


def cmd_secret_decline(args):
    if not args: die("usage: herdr-pr secret-decline <id>")
    a = read_secret_ask(args[0])
    if not a: die(f"no secret request {args[0]}")
    a["state"], a["updated"] = "declined", time.time()
    write_secret_ask(a)
    print("declined")


def cmd_inbox(args):
    """Everything waiting on this machine in one call (the Herdr panels poll this):
    pending merge asks, pending secret requests, requests queued for a scheduler, and whether
    this machine is a scheduler."""
    asks = [a for a in all_asks() if a["state"] == "pending"]
    secrets = []
    try:
        names = sorted(n for n in os.listdir(SECRETS) if n.endswith(".json"))
    except FileNotFoundError:
        names = []
    for n in names:
        a = read_secret_ask(n[:-5])
        if a and a.get("state") == "pending":
            secrets.append(a)
    print(json.dumps({"version": VERSION, "server": is_server(), "asks": asks, "secrets": secrets, "outbox": read_outbox()}))


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__.strip()); return
    cmds = {"schedule": cmd_schedule, "list": cmd_list, "cancel": cmd_cancel, "run-due": cmd_run_due,
            "setup": cmd_setup, "install-cron": cmd_setup, "remove": cmd_remove, "status": cmd_status,
            "outbox": cmd_outbox, "outbox-done": cmd_outbox_done,
            "ask": cmd_ask, "ask-status": cmd_ask_status, "asks": cmd_asks, "answer": cmd_answer,
            "secret": cmd_secret, "secret-status": cmd_secret_status, "secrets": cmd_secrets,
            "secret-fill": cmd_secret_fill, "secret-decline": cmd_secret_decline, "inbox": cmd_inbox}
    if a[0] not in cmds: die(f"unknown command {a[0]} (see herdr-pr help)")
    cmds[a[0]](a[1:])


if __name__ == "__main__":
    main()
